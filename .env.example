# Orchestrator (LangGraph plan LLM)
OPENAI_API_KEY=
PLAN_MODEL=gpt-4.1-mini

# Main repo clones (worktrees branch from these; use N/A if not applicable)
CLIENT_REPO_PATH=N/A
SERVER_REPO_PATH=/absolute/path/to/agora-api-monorepo

# Agent daemon (pnpm run agentd) — unix socket + HTTP API for the web UI
AGENT_SERVER_SOCKET=.agent-runs/agent.sock
AGENT_SERVER_HOST=127.0.0.1
# Optional NDJSON tcp (must differ from AGENT_HTTP_PORT)
# AGENT_SERVER_PORT=9477

# HTTP API (started by agentd; also pnpm run httpd standalone)
AGENT_HTTP_PORT=9478
AGENT_HTTP_CORS=http://localhost:5173

# Default agent id for checkpoint threads (same as --agent-id)
AGENT_ID=ilan

# Developer runtime: cursor (default) | codex
AGENT_RUNTIME=cursor

# Cursor Agent CLI (~/.local/bin/agent) — run `agent login` once
CURSOR_API_KEY=
CURSOR_AGENT_BIN=agent
CURSOR_AGENT_MODEL=composer-2.5

# Codex CLI fallback when AGENT_RUNTIME=codex
CODEX_API_KEY=

# Retry limit
MAX_CODEX_ATTEMPTS=3

# Agent skills directory (default: .cursor/skills in this repo)
AGENT_SKILLS_PATH=.cursor/skills

# Set to 1 to stream Codex/lint output (same as --verbose)
AGENT_VERBOSE=0

# agentd operational logs: info (default) | debug | off
AGENT_LOG_LEVEL=info

# Set to 1 to skip lint/test validation after implement (go straight to ship review)
SKIP_VALIDATE=0

# Set to 1 to inline full .cursor/skills bodies (same as --full-skills)
AGENT_FULL_SKILLS=0

# Slack bot (pnpm run slack) — Socket Mode
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
SLACK_MODE=socket
SLACK_AGENT_ID=ilanlevy
SLACK_ALLOWED_CHANNEL_IDS=C01234567,C76543210
